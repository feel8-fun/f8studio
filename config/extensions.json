    {
      "extensionId": "diagnostics",
      "name": "Diagnostics",
      "version": "0.2.0",
      "description": "Optional debugging tools for streams, protocols, and runtime integrations.",
      "serviceClasses": [],
      "tools": [
        {
          "toolId": "skeleton-verify",
          "name": "Verify skeleton UDP stream",
          "description": "Listen for complete decoded skeleton frames; report malformed packets and incomplete chunks.",
          "command": "python",
          "args": [
            "-m",
            "f8diagnostics.verify"
          ],
          "workdir": "${F8_PACKAGE_ROOT}",
          "fields": [
            {
              "name": "bindAddress",
              "label": "Listen address",
              "kind": "string",
              "required": true,
              "default": "127.0.0.1",
              "choices": []
            },
            {
              "name": "port",
              "label": "Listen port",
              "kind": "integer",
              "required": true,
              "default": 39540,
              "choices": []
            },
            {
              "name": "timeoutMs",
              "label": "Listen timeout (ms)",
              "kind": "integer",
              "required": true,
              "default": 2000,
              "choices": []
            },
            {
              "name": "minimumFrames",
              "label": "Minimum complete frames",
              "kind": "integer",
              "required": true,
              "default": 1,
              "choices": []
            }
          ],
          "platforms": [],
          "timeoutSeconds": 35,
          "requiresConfirmation": false,
          "allowConcurrent": true
        },
        {
          "toolId": "skeleton-simulate",
          "name": "Send simulated skeleton stream",
          "description": "Continuously send a two-bone animated JSON skeleton stream until stopped. Verify the stream or inspect a graph while it runs.",
          "command": "python",
          "args": [
            "-m",
            "f8diagnostics.simulate"
          ],
          "workdir": "${F8_PACKAGE_ROOT}",
          "fields": [
            {
              "name": "destination",
              "label": "Destination address",
              "kind": "string",
              "required": true,
              "default": "127.0.0.1",
              "choices": []
            },
            {
              "name": "port",
              "label": "Destination port",
              "kind": "integer",
              "required": true,
              "default": 39540,
              "choices": []
            },
            {
              "name": "durationSeconds",
              "label": "Duration (seconds; blank = until stopped)",
              "kind": "number",
              "required": false,
              "default": null,
              "choices": []
            },
            {
              "name": "fps",
              "label": "Frames per second (max 120)",
              "kind": "integer",
              "required": true,
              "default": 30,
              "choices": []
            },
            {
              "name": "modelName",
              "label": "Model name",
              "kind": "string",
              "required": true,
              "default": "F8 diagnostic skeleton",
              "choices": []
            }
          ],
          "platforms": [],
          "timeoutSeconds": null,
          "requiresConfirmation": true,
          "allowConcurrent": true
        }
      ],
      "skills": [],
      "resources": [],
