{
  "schemaVersion": "f8extensionCatalog/1",
  "preinstalled": ["audiocap", "audiofeat", "cppengine", "cvkit", "dl", "implayer", "mediapipe", "pyengine", "proclauncher", "pyexpr", "pyscript", "screencap"],
  "extensions": [
    {"extensionId": "audiocap", "name": "Audio Capture", "version": "0.0.1", "description": "Capture system and microphone audio.", "serviceClasses": ["f8.audiocap"]},
    {"extensionId": "audiofeat", "name": "Audio Features", "version": "0.0.1", "description": "Analyze audio features and rhythm.", "serviceClasses": ["f8.audiofeat.core", "f8.audiofeat.rhythm"], "runtime": {"kind": "workspace", "environment": "default"}},
    {"extensionId": "cppengine", "name": "C++ Engine", "version": "0.0.1", "description": "Run native processing graphs.", "serviceClasses": ["f8.cppengine"]},
    {"extensionId": "cvkit", "name": "Computer Vision", "version": "0.0.1", "description": "Track objects, match templates, stabilize video and analyze optical flow.", "serviceClasses": ["f8.cvkit.denseoptflow", "f8.cvkit.flowmetric", "f8.cvkit.templatematch", "f8.cvkit.tracking", "f8.cvkit.videostab"]},
    {"extensionId": "dl", "name": "Deep Learning", "version": "0.0.1", "description": "Run ONNX models for classification, detection and motion analysis.", "serviceClasses": ["f8.dl.classifier", "f8.dl.detector", "f8.dl.detsorter", "f8.dl.humandetector", "f8.dl.optflow", "f8.dl.tcnwave"], "runtime": {"kind": "workspace", "environment": "onnx"}, "modelDirectories": ["onnx"]},
    {"extensionId": "implayer", "name": "Image and Video Player", "version": "0.0.1", "description": "Play image and video sources.", "serviceClasses": ["f8.implayer"]},
    {"extensionId": "mediapipe", "name": "MediaPipe Pose", "version": "0.0.1", "description": "Estimate body pose with MediaPipe.", "serviceClasses": ["f8.mp.pose"], "runtime": {"kind": "workspace", "environment": "mediapipe"}, "modelDirectories": ["mediapipe"]},
    {"extensionId": "pyengine", "name": "Python Engine", "version": "0.0.1", "description": "Run Python processing graphs.", "serviceClasses": ["f8.pyengine"], "runtime": {"kind": "workspace", "environment": "web-studio-runtime"}},
    {"extensionId": "proclauncher", "name": "Process Launcher", "version": "0.0.1", "description": "Launch external processes from a graph.", "serviceClasses": ["f8.proclauncher"], "runtime": {"kind": "workspace", "environment": "default"}},
    {"extensionId": "pyexpr", "name": "Python Expressions", "version": "0.0.1", "description": "Evaluate Python expressions.", "serviceClasses": ["f8.pyexpr"], "runtime": {"kind": "workspace", "environment": "default"}},
    {"extensionId": "pyscript", "name": "Python Scripts", "version": "0.0.1", "description": "Run custom Python scripts.", "serviceClasses": ["f8.pyscript"], "runtime": {"kind": "workspace", "environment": "default"}},
    {"extensionId": "screencap", "name": "Screen Capture", "version": "0.0.1", "description": "Capture desktop video.", "serviceClasses": ["f8.screencap"]}
  ]
}
