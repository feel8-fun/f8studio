{
  "$defs": {
    "ExtensionCatalog": {
      "additionalProperties": false,
      "properties": {
        "extensions": {
          "items": {
            "$ref": "#/$defs/ExtensionManifest"
          },
          "type": "array"
        },
        "preinstalled": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "schemaVersion": {
          "enum": [
            "f8extensionCatalog/1"
          ]
        }
      },
      "required": [
        "schemaVersion",
        "extensions"
      ],
      "title": "ExtensionCatalog",
      "type": "object"
    },
    "ExtensionManifest": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "extensionId": {
          "type": "string"
        },
        "modelDirectories": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "name": {
          "type": "string"
        },
        "resources": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ExtensionResource"
          },
          "type": "array"
        },
        "runtime": {
          "$ref": "#/$defs/ExtensionRuntime",
          "default": {
            "dependencies": [],
            "environment": null,
            "kind": "native",
            "requiresPython": null
          }
        },
        "serviceClasses": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "skills": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ExtensionSkill"
          },
          "type": "array"
        },
        "tools": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ExtensionTool"
          },
          "type": "array"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "extensionId",
        "name",
        "version",
        "description"
      ],
      "title": "ExtensionManifest",
      "type": "object"
    },
    "ExtensionResource": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "default": "",
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "resourceId": {
          "type": "string"
        }
      },
      "required": [
        "resourceId",
        "path"
      ],
      "title": "ExtensionResource",
      "type": "object"
    },
    "ExtensionRuntime": {
      "additionalProperties": false,
      "properties": {
        "dependencies": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "environment": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "kind": {
          "default": "native",
          "enum": [
            "bundled",
            "native",
            "pixi",
            "shared",
            "workspace"
          ]
        },
        "requiresPython": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [],
      "title": "ExtensionRuntime",
      "type": "object"
    },
    "ExtensionSkill": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string"
        },
        "skillId": {
          "type": "string"
        }
      },
      "required": [
        "skillId",
        "path"
      ],
      "title": "ExtensionSkill",
      "type": "object"
    },
    "ExtensionTool": {
      "additionalProperties": false,
      "properties": {
        "args": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "command": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "fields": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ExtensionToolField"
          },
          "type": "array"
        },
        "name": {
          "type": "string"
        },
        "platforms": {
          "default": [],
          "items": {
            "enum": [
              "darwin",
              "linux",
              "win32"
            ]
          },
          "type": "array"
        },
        "requiresConfirmation": {
          "default": true,
          "type": "boolean"
        },
        "timeoutSeconds": {
          "default": 300,
          "type": "integer"
        },
        "toolId": {
          "type": "string"
        },
        "workdir": {
          "default": "${F8_PACKAGE_ROOT}",
          "type": "string"
        }
      },
      "required": [
        "toolId",
        "name",
        "description",
        "command"
      ],
      "title": "ExtensionTool",
      "type": "object"
    },
    "ExtensionToolField": {
      "additionalProperties": false,
      "properties": {
        "choices": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "default": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "boolean"
            },
            {
              "type": "object"
            },
            {
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Any JSON value."
        },
        "kind": {
          "default": "string",
          "enum": [
            "boolean",
            "integer",
            "number",
            "string"
          ]
        },
        "label": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "required": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "label"
      ],
      "title": "ExtensionToolField",
      "type": "object"
    }
  },
  "$ref": "#/$defs/ExtensionCatalog"
}
