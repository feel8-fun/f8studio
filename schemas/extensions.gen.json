{
  "$defs": {
    "ApplicationDependency": {
      "additionalProperties": false,
      "properties": {
        "extensionId": {
          "type": "string"
        },
        "protocolId": {
          "type": "string"
        },
        "versions": {
          "type": "string"
        }
      },
      "required": [
        "extensionId",
        "protocolId",
        "versions"
      ],
      "title": "ApplicationDependency",
      "type": "object"
    },
    "ApplicationEndpoint": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "url"
      ],
      "title": "ApplicationEndpoint",
      "type": "object"
    },
    "ApplicationHealth": {
      "additionalProperties": false,
      "properties": {
        "bootstrapPath": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "endpoint": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "protocolVersion": {
          "type": "string"
        },
        "service": {
          "type": "string"
        },
        "timeoutSeconds": {
          "default": 30.0,
          "type": "number"
        }
      },
      "required": [
        "endpoint",
        "path",
        "service",
        "protocolVersion"
      ],
      "title": "ApplicationHealth",
      "type": "object"
    },
    "ApplicationLaunch": {
      "additionalProperties": false,
      "properties": {
        "args": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "distribution": {
          "type": "string"
        },
        "env": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "type": "object"
        },
        "environment": {
          "type": "string"
        },
        "module": {
          "type": "string"
        }
      },
      "required": [
        "environment",
        "module",
        "distribution"
      ],
      "title": "ApplicationLaunch",
      "type": "object"
    },
    "ApplicationProtocol": {
      "additionalProperties": false,
      "properties": {
        "protocolId": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "protocolId",
        "version"
      ],
      "title": "ApplicationProtocol",
      "type": "object"
    },
    "ApplicationSpec": {
      "additionalProperties": false,
      "properties": {
        "endpoints": {
          "items": {
            "$ref": "#/$defs/ApplicationEndpoint"
          },
          "type": "array"
        },
        "health": {
          "$ref": "#/$defs/ApplicationHealth"
        },
        "launch": {
          "$ref": "#/$defs/ApplicationLaunch"
        },
        "provides": {
          "items": {
            "$ref": "#/$defs/ApplicationProtocol"
          },
          "type": "array"
        },
        "releaseRole": {
          "default": "application",
          "enum": [
            "application",
            "webstudio"
          ]
        },
        "requires": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ApplicationDependency"
          },
          "type": "array"
        },
        "webAssets": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "launch",
        "provides",
        "endpoints",
        "health"
      ],
      "title": "ApplicationSpec",
      "type": "object"
    },
    "ExtensionCatalog": {
      "additionalProperties": false,
      "properties": {
        "extensions": {
          "items": {
            "$ref": "#/$defs/ExtensionManifest"
          },
          "type": "array"
        },
        "preinstalled": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "schemaVersion": {
          "enum": [
            "f8extensionCatalog/1"
          ]
        }
      },
      "required": [
        "schemaVersion",
        "extensions"
      ],
      "title": "ExtensionCatalog",
      "type": "object"
    },
    "ExtensionManifest": {
      "additionalProperties": false,
      "properties": {
        "application": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/ApplicationSpec"
            }
          ],
          "default": null
        },
        "description": {
          "type": "string"
        },
        "extensionId": {
          "type": "string"
        },
        "modelDirectories": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "name": {
          "type": "string"
        },
        "resources": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ExtensionResource"
          },
          "type": "array"
        },
        "runtime": {
          "$ref": "#/$defs/ExtensionRuntime",
          "default": {
            "abi": null,
            "dependencies": [],
            "environment": null,
            "kind": "native",
            "providerId": null,
            "providerVersion": null,
            "requiresPython": null
          }
        },
        "serviceClasses": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "skills": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ExtensionSkill"
          },
          "type": "array"
        },
        "tools": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ExtensionTool"
          },
          "type": "array"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "extensionId",
        "name",
        "version",
        "description"
      ],
      "title": "ExtensionManifest",
      "type": "object"
    },
    "ExtensionResource": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "default": "",
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "resourceId": {
          "type": "string"
        }
      },
      "required": [
        "resourceId",
        "path"
      ],
      "title": "ExtensionResource",
      "type": "object"
    },
    "ExtensionRuntime": {
      "additionalProperties": false,
      "properties": {
        "abi": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "dependencies": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "environment": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "kind": {
          "default": "native",
          "enum": [
            "bundled",
            "native",
            "pixi",
            "shared",
            "workspace"
          ]
        },
        "providerId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "providerVersion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "requiresPython": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [],
      "title": "ExtensionRuntime",
      "type": "object"
    },
    "ExtensionSkill": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string"
        },
        "skillId": {
          "type": "string"
        }
      },
      "required": [
        "skillId",
        "path"
      ],
      "title": "ExtensionSkill",
      "type": "object"
    },
    "ExtensionTool": {
      "additionalProperties": false,
      "properties": {
        "allowConcurrent": {
          "default": false,
          "type": "boolean"
        },
        "args": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "command": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "fields": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ExtensionToolField"
          },
          "type": "array"
        },
        "name": {
          "type": "string"
        },
        "platforms": {
          "default": [],
          "items": {
            "enum": [
              "darwin",
              "linux",
              "win32"
            ]
          },
          "type": "array"
        },
        "requiresConfirmation": {
          "default": true,
          "type": "boolean"
        },
        "timeoutSeconds": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": 300
        },
        "toolId": {
          "type": "string"
        },
        "workdir": {
          "default": "${F8_PACKAGE_ROOT}",
          "type": "string"
        }
      },
      "required": [
        "toolId",
        "name",
        "description",
        "command"
      ],
      "title": "ExtensionTool",
      "type": "object"
    },
    "ExtensionToolField": {
      "additionalProperties": false,
      "properties": {
        "choices": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "default": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "boolean"
            },
            {
              "type": "object"
            },
            {
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Any JSON value."
        },
        "kind": {
          "default": "string",
          "enum": [
            "boolean",
            "integer",
            "number",
            "string"
          ]
        },
        "label": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "required": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "label"
      ],
      "title": "ExtensionToolField",
      "type": "object"
    }
  },
  "$ref": "#/$defs/ExtensionCatalog"
}
