[importlinter]
root_packages =
    f8platform
    f8pysdk
    f8studio_core
    f8media_protocol
    f8media_gateway
    f8studio_server

[importlinter:contract:core-boundary]
name = Graph domain does not depend on server or media implementation
type = forbidden
source_modules =
    f8studio_core
forbidden_modules =
    f8studio_server
    f8media_gateway

[importlinter:contract:sdk-boundary]
name = SDK does not depend on Studio
type = forbidden
source_modules =
    f8pysdk
forbidden_modules =
    f8studio_core
    f8studio_server
    f8media_gateway

[importlinter:contract:media-boundary]
name = Media protocol and gateway do not depend on Studio server
type = forbidden
source_modules =
    f8media_protocol
    f8media_gateway
forbidden_modules =
    f8studio_server

[importlinter:contract:platform-boundary]
name = Platform manages components without importing applications
type = forbidden
source_modules =
    f8platform
forbidden_modules =
    f8studio_server
    f8studio_core
    f8media_gateway
    f8media_protocol

[importlinter:contract:studio-platform-client]
name = WebStudio uses SDK platform contracts without platform implementation imports
type = forbidden
source_modules =
    f8studio_server
forbidden_modules =
    f8platform
