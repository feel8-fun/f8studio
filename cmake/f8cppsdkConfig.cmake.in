@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(nlohmann_json CONFIG)
find_dependency(spdlog CONFIG)
if(@F8_WITH_ZENOH@)
    find_dependency(zenohc CONFIG)
    find_dependency(zenohcxx CONFIG)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/f8cppsdkTargets.cmake")
if(NOT TARGET f8cppsdk)
    add_library(f8cppsdk ALIAS f8::f8cppsdk)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/F8ServiceRuntime.cmake")
check_required_components(f8cppsdk)
