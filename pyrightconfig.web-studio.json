{
  "$schema": "https://raw.githubusercontent.com/microsoft/pyright/main/packages/pyright/schema/pyrightconfig.schema.json",
  "pythonVersion": "3.14",
  "typeCheckingMode": "strict",
  "include": [
    "platform/f8platform",
    "extensions/f8webstudio/f8studio_core/f8studio_core",
    "sdk/python/f8media_protocol",
    "extensions/f8mediagateway/f8media_gateway",
    "extensions/f8webstudio/f8studio_server/f8studio_server",
    "scripts/web_studio",
    "scripts/workspace_inputs.py",
    "scripts/workspace_runtime.py",
    "scripts/verify_workspace_sdk.py",
    "scripts/workspace_clean.py",
    "sdk/python/f8pysdk/runtime_packaging.py",
    "sdk/python/f8pysdk/application_spec.py",
    "sdk/python/f8pysdk/platform_spec.py",
    "sdk/python/f8pysdk/platform_api.py",
    "sdk/python/f8pysdk/management_job.py",
    "sdk/python/f8pysdk/platform_client.py",
    "sdk/python/f8pysdk/extension_status.py",
    "sdk/python/f8pysdk/tool_spec.py",
    "scripts/platform_workspace.py",
    "sdk/python/f8pysdk/application_package.py",
    "sdk/python/f8pysdk/application_packaging.py",
    "sdk/python/f8pysdk/release_spec.py",
    "sdk/python/f8pysdk/runtime_package.py",
    "sdk/python/f8pysdk/extension_packaging.py",
    "sdk/python/f8pysdk/extension_runtime_build.py"
  ],
  "exclude": [
    ".pixi",
    "build",
    "**/__pycache__"
  ],
  "reportMissingTypeStubs": "none",
  "executionEnvironments": [
    {
      "root": "scripts",
      "extraPaths": [
        "scripts",
        "sdk/python",
        "platform"
      ]
    },
    {
      "root": "."
    }
  ]
}
